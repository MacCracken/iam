# iam test suite — formatter logic + ADR-contract byte-exact tests.
#
# Includes the formatter sources directly (not src/main.cyr — that
# file's module-level `var r = main(); syscall(...)` would run iam
# before any assertions). End-to-end probe wiring is exercised by
# running ./build/iam in CI / by hand; here we cover pure-function
# layout logic against fixed inputs.
#
# Byte-exact tests against synthetic values (no mihi probes) are
# the executable form of docs/adr/0002-output-shape-reorder.md
# (which supersedes ADR 0001 §2-§3). Any change to the contract
# has to land here and in the ADR or both.
#
# Stdlib auto-included via cyrius.cyml.

include "src/display.cyr"
include "src/uptime.cyr"

# Assert a buf+len buffer equals an expected cstring byte-for-byte.
fn assert_buf_eq(buf, blen, expected, msg) {
    var elen = strlen(expected);
    assert_eq(blen, elen, msg);
    if (blen != elen) { return 0; }
    var i = 0;
    var ok = 1;
    while (i < blen) {
        if (load8(buf + i) != load8(expected + i)) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, msg);
    return 0;
}

fn main() {
    alloc_init();

    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");

    # ----- iam_uint_into ---------------------------------------------
    test_group("display.cyr — iam_uint_into");
    var ub[24];
    var n = iam_uint_into(&ub, 24, 0);
    assert_buf_eq(&ub, n, "0", "0 → \"0\"");
    n = iam_uint_into(&ub, 24, 7);
    assert_buf_eq(&ub, n, "7", "7 → \"7\"");
    n = iam_uint_into(&ub, 24, 12345);
    assert_buf_eq(&ub, n, "12345", "12345 → \"12345\"");
    n = iam_uint_into(&ub, 24, 999999);
    assert_buf_eq(&ub, n, "999999", "999999 → \"999999\"");
    # cap-too-small returns 0 without partial writes
    n = iam_uint_into(&ub, 2, 12345);
    assert_eq(n, 0, "cap=2 for 5-digit number rejects (returns 0)");
    # negative input rejected
    n = iam_uint_into(&ub, 24, 0 - 1);
    assert_eq(n, 0, "negative input rejected");

    # ----- iam_format_bytes ------------------------------------------
    # Floor-rounding is the contract — exact-string matches.
    test_group("display.cyr — iam_format_bytes");
    var bb[24];
    n = iam_format_bytes(0, &bb, 24);
    assert_buf_eq(&bb, n, "0 B", "0 → \"0 B\"");
    n = iam_format_bytes(42, &bb, 24);
    assert_buf_eq(&bb, n, "42 B", "42 → \"42 B\"");
    n = iam_format_bytes(1023, &bb, 24);
    assert_buf_eq(&bb, n, "1023 B", "1023 → \"1023 B\" (B boundary)");
    n = iam_format_bytes(1024, &bb, 24);
    assert_buf_eq(&bb, n, "1 KiB", "1024 → \"1 KiB\"");
    n = iam_format_bytes(1500, &bb, 24);
    assert_buf_eq(&bb, n, "1 KiB", "1500 → \"1 KiB\" (floor)");
    n = iam_format_bytes(1048576, &bb, 24);
    assert_buf_eq(&bb, n, "1 MiB", "1 MiB → \"1 MiB\"");
    n = iam_format_bytes(1073741824, &bb, 24);
    assert_buf_eq(&bb, n, "1 GiB", "1 GiB → \"1 GiB\"");
    # 31 GiB shape from the M1+M2 scope preview
    n = iam_format_bytes(31 * 1073741824, &bb, 24);
    assert_buf_eq(&bb, n, "31 GiB", "31 GiB → \"31 GiB\" (preview match)");
    n = iam_format_bytes(1099511627776, &bb, 24);
    assert_buf_eq(&bb, n, "1 TiB", "1 TiB → \"1 TiB\"");
    # Negative input → error signal (blen 0)
    n = iam_format_bytes(0 - 1, &bb, 24);
    assert_eq(n, 0, "negative bytes → 0 (probe-fail signal)");
    # cap-too-small → 0
    n = iam_format_bytes(31 * 1073741824, &bb, 5);
    assert_eq(n, 0, "cap=5 for \"31 GiB\" rejects");

    # ----- iam_format_uptime -----------------------------------------
    test_group("uptime.cyr — iam_format_uptime");
    var ut[24];
    n = iam_format_uptime(0, &ut, 24);
    assert_buf_eq(&ut, n, "<1m", "0 → \"<1m\" (fresh-boot fallback)");
    n = iam_format_uptime(59, &ut, 24);
    assert_buf_eq(&ut, n, "<1m", "59s → \"<1m\"");
    n = iam_format_uptime(60, &ut, 24);
    assert_buf_eq(&ut, n, "1m", "60s → \"1m\"");
    n = iam_format_uptime(180, &ut, 24);
    assert_buf_eq(&ut, n, "3m", "180s → \"3m\"");
    n = iam_format_uptime(3600, &ut, 24);
    assert_buf_eq(&ut, n, "1h", "3600s → \"1h\" (mins-elision)");
    n = iam_format_uptime(3600 + 180, &ut, 24);
    assert_buf_eq(&ut, n, "1h 3m", "3780s → \"1h 3m\"");
    n = iam_format_uptime(86400, &ut, 24);
    assert_buf_eq(&ut, n, "1d", "86400s → \"1d\" (hours+mins-elision)");
    n = iam_format_uptime(86400 + 7200 + 180, &ut, 24);
    assert_buf_eq(&ut, n, "1d 2h 3m", "preview-shape: 1d 2h 3m");
    n = iam_format_uptime(2 * 86400 + 60, &ut, 24);
    assert_buf_eq(&ut, n, "2d 1m", "elide-zero-hours: 2d 1m");
    # cap-too-small short-circuits
    n = iam_format_uptime(86400 + 7200 + 180, &ut, 3);
    assert_eq(n, 0, "cap=3 for \"1d 2h 3m\" rejects");

    # ----- iam_render — per-label padding ----------------------------
    # ADR 0001 §1 (carried over by 0002): every line has an 8-byte
    # label column. Each of the seven labels gets its own assertion
    # to lock the pad width against accidental drift.
    test_group("display.cyr — iam_render label column (ADR 0001 §1)");
    var rb[256];
    n = iam_render(&rb, 256, "CPU", "Intel Core i9");
    assert_buf_eq(&rb, n, "CPU:    Intel Core i9\n", "CPU label: 4 pad spaces");
    n = iam_render(&rb, 256, "Memory", "16 GiB");
    assert_buf_eq(&rb, n, "Memory: 16 GiB\n", "Memory label: 1 pad space");
    n = iam_render(&rb, 256, "Kernel", "Linux 7.0");
    assert_buf_eq(&rb, n, "Kernel: Linux 7.0\n", "Kernel label: 1 pad space");
    n = iam_render(&rb, 256, "Host", "testbox");
    assert_buf_eq(&rb, n, "Host:   testbox\n", "Host label: 3 pad spaces");
    n = iam_render(&rb, 256, "Distro", "Arch Linux");
    assert_buf_eq(&rb, n, "Distro: Arch Linux\n", "Distro label: 1 pad space");
    n = iam_render(&rb, 256, "Uptime", "1h 2m");
    assert_buf_eq(&rb, n, "Uptime: 1h 2m\n", "Uptime label: 1 pad space");
    n = iam_render(&rb, 256, "GPU", "AMD Radeon");
    assert_buf_eq(&rb, n, "GPU:    AMD Radeon\n", "GPU label: 4 pad spaces");

    # ----- iam_render — unknown fallback (ADR 0001 §4) ---------------
    # Probe returned 0 (null cstring) → emit "(unknown)" in value
    # column. Required-label lines are NEVER suppressed on probe
    # failure; the contract is "always six lines, always in order".
    # ADR 0001 §4 carries over unchanged under ADR 0002.
    test_group("display.cyr — iam_render unknown fallback (ADR 0001 §4)");
    n = iam_render(&rb, 256, "CPU", 0);
    assert_buf_eq(&rb, n, "CPU:    (unknown)\n", "CPU + value=0 → (unknown)");
    n = iam_render(&rb, 256, "Memory", 0);
    assert_buf_eq(&rb, n, "Memory: (unknown)\n", "Memory + value=0 → (unknown)");
    n = iam_render(&rb, 256, "Host", 0);
    assert_buf_eq(&rb, n, "Host:   (unknown)\n", "Host + value=0 → (unknown)");

    # ----- iam_render — overflow signaling ---------------------------
    test_group("display.cyr — iam_render overflow");
    var sb[10];
    n = iam_render(&sb, 10, "CPU", "TooLongForThisBuffer");
    assert_eq(n, 0 - 1, "cap=10 overflow returns -1");

    # ----- iam_render_buf — buf+len value variant --------------------
    test_group("display.cyr — iam_render_buf");
    var memval = "59 GiB";
    n = iam_render_buf(&rb, 256, "Memory", memval, 6);
    assert_buf_eq(&rb, n, "Memory: 59 GiB\n", "Memory: buf+len value");
    # vlen=0 → unknown fallback (formatter signal)
    n = iam_render_buf(&rb, 256, "Uptime", memval, 0);
    assert_buf_eq(&rb, n, "Uptime: (unknown)\n", "Uptime + vlen=0 → unknown");
    # vlen<0 same signal
    n = iam_render_buf(&rb, 256, "Memory", memval, 0 - 1);
    assert_buf_eq(&rb, n, "Memory: (unknown)\n", "Memory + vlen=-1 → unknown");

    # ----- iam_render_kernel — two-cstring join ---------------------
    test_group("display.cyr — iam_render_kernel");
    n = iam_render_kernel(&rb, 256, "Kernel", "Linux", "7.0.5-arch1-1");
    assert_buf_eq(&rb, n, "Kernel: Linux 7.0.5-arch1-1\n",
      "kernel: name + ' ' + version");
    # name=0 → unknown
    n = iam_render_kernel(&rb, 256, "Kernel", 0, "7.0.5");
    assert_buf_eq(&rb, n, "Kernel: (unknown)\n", "kernel name=0 → unknown");
    # version=0 → unknown
    n = iam_render_kernel(&rb, 256, "Kernel", "Linux", 0);
    assert_buf_eq(&rb, n, "Kernel: (unknown)\n", "kernel version=0 → unknown");

    # ----- F-001 TTY-escape / control-char sanitization --------------
    # F-001 mitigation: iam_copy_value (display.cyr) replaces any
    # byte < 0x20 with '?' (0x3F) when copying value-column bytes.
    # Covers ANSI CSI escapes (0x1B), TAB (0x09), stray newlines
    # (0x0A), and the rest of the C0 control range. Label, padding,
    # and IAM_UNKNOWN_TEXT bytes are iam-controlled and not
    # sanitized.
    #
    # Inputs are built with explicit store8 calls — no reliance on
    # Cyrius string-literal escape support beyond \n.
    test_group("display.cyr — F-001 TTY-escape sanitization");

    # iam_copy_value boundary cases — 0x1F → '?', 0x20 → ' ' (unchanged)
    var cv[16];
    var cvin[4];
    store8(&cvin + 0, 31);  # 0x1F (US — last C0 control)
    store8(&cvin + 1, 32);  # 0x20 (space — first printable)
    store8(&cvin + 2, 65);  # 'A'
    store8(&cvin + 3, 9);   # 0x09 (TAB)
    n = iam_copy_value(&cv, 16, 0, &cvin, 4);
    assert_eq(n, 4, "iam_copy_value: returns new pos for 4-byte input");
    assert_eq(load8(&cv + 0), 63, "byte 0x1F → '?'");
    assert_eq(load8(&cv + 1), 32, "byte 0x20 unchanged (space)");
    assert_eq(load8(&cv + 2), 65, "byte 'A' unchanged");
    assert_eq(load8(&cv + 3), 63, "byte 0x09 (TAB) → '?'");

    # iam_render: ESC-laden CPU model. Build "\x1b[31mRed" as cstring.
    var ev[16];
    store8(&ev + 0, 27);   # ESC (0x1B)
    store8(&ev + 1, 91);   # '['
    store8(&ev + 2, 51);   # '3'
    store8(&ev + 3, 49);   # '1'
    store8(&ev + 4, 109);  # 'm'
    store8(&ev + 5, 82);   # 'R'
    store8(&ev + 6, 101);  # 'e'
    store8(&ev + 7, 100);  # 'd'
    store8(&ev + 8, 0);    # NUL
    n = iam_render(&rb, 256, "CPU", &ev);
    assert_buf_eq(&rb, n, "CPU:    ?[31mRed\n",
      "iam_render: ESC sanitized to '?'");

    # iam_render: newline-injection attempt in value would otherwise
    # break the line-equals-one-fact contract. Sanitizer catches it.
    var nv[8];
    store8(&nv + 0, 65);   # 'A'
    store8(&nv + 1, 10);   # 0x0A (LF) — injection attempt
    store8(&nv + 2, 66);   # 'B'
    store8(&nv + 3, 0);    # NUL
    n = iam_render(&rb, 256, "Host", &nv);
    assert_buf_eq(&rb, n, "Host:   A?B\n",
      "iam_render: LF injection sanitized to '?'");

    # iam_render_buf: control byte mid-buffer.
    var bv[6];
    store8(&bv + 0, 49);   # '1'
    store8(&bv + 1, 32);   # ' '
    store8(&bv + 2, 27);   # ESC
    store8(&bv + 3, 71);   # 'G'
    store8(&bv + 4, 105);  # 'i'
    store8(&bv + 5, 66);   # 'B'
    n = iam_render_buf(&rb, 256, "Memory", &bv, 6);
    assert_buf_eq(&rb, n, "Memory: 1 ?GiB\n",
      "iam_render_buf: ESC mid-buffer sanitized");

    # iam_render_kernel: ESC in both name and version.
    var kn[8];
    store8(&kn + 0, 27);   # ESC
    store8(&kn + 1, 76);   # 'L'
    store8(&kn + 2, 105);  # 'i'
    store8(&kn + 3, 110);  # 'n'
    store8(&kn + 4, 117);  # 'u'
    store8(&kn + 5, 120);  # 'x'
    store8(&kn + 6, 0);    # NUL
    var kv[8];
    store8(&kv + 0, 55);   # '7'
    store8(&kv + 1, 46);   # '.'
    store8(&kv + 2, 48);   # '0'
    store8(&kv + 3, 9);    # TAB
    store8(&kv + 4, 49);   # '1'
    store8(&kv + 5, 0);    # NUL
    n = iam_render_kernel(&rb, 256, "Kernel", &kn, &kv);
    assert_buf_eq(&rb, n, "Kernel: ?Linux 7.0?1\n",
      "iam_render_kernel: ESC + TAB sanitized in name + version");

    # IAM_UNKNOWN_TEXT path is NOT sanitized — it's iam-controlled
    # plain ASCII, but proving the bytes are exact (no incidental
    # change from F-001) locks the v0.5.0 behavior in place.
    n = iam_render(&rb, 256, "Distro", 0);
    assert_buf_eq(&rb, n, "Distro: (unknown)\n",
      "F-001: unknown fallback bytes unchanged");

    # ----- iam_render_gpu — name + optional size suffix (ADR 0003) ---
    # The GPU line is the only one whose value column composes two
    # facts. Both degrade paths are silent by contract: no size →
    # bare name (byte-identical to the pre-0003 line), no name →
    # `(unknown)` regardless of the size. Sits after the F-001 group
    # so the ESC-laden `ev` fixture is already built.
    test_group("display.cyr — iam_render_gpu (ADR 0003)");
    var gmem = "3 GiB";
    n = iam_render_gpu(&rb, 256, "GPU", "AMD Radeon", gmem, 5);
    assert_buf_eq(&rb, n, "GPU:    AMD Radeon [3 GiB]\n",
      "gpu: name + bracketed size suffix");
    # Real archaemenid shape — the device name already carries a
    # parenthesised PCI id, which is why the suffix uses brackets.
    n = iam_render_gpu(&rb, 256, "GPU", "AMD Radeon (PCI 0x1002:0x1638)",
      gmem, 5);
    assert_buf_eq(&rb, n, "GPU:    AMD Radeon (PCI 0x1002:0x1638) [3 GiB]\n",
      "gpu: parenthesised PCI id + bracketed size");
    # mlen=0 — backend reported no size. Bare name, no placeholder.
    n = iam_render_gpu(&rb, 256, "GPU", "AMD Radeon", gmem, 0);
    assert_buf_eq(&rb, n, "GPU:    AMD Radeon\n",
      "gpu: mlen=0 → bare name (pre-0003 bytes)");
    # mlen<0 — mihi's out-of-range sentinel. Same degrade.
    n = iam_render_gpu(&rb, 256, "GPU", "AMD Radeon", gmem, 0 - 1);
    assert_buf_eq(&rb, n, "GPU:    AMD Radeon\n",
      "gpu: mlen=-1 → bare name");
    # name=0 — probe failure. Unknown fallback, size discarded.
    n = iam_render_gpu(&rb, 256, "GPU", 0, gmem, 5);
    assert_buf_eq(&rb, n, "GPU:    (unknown)\n",
      "gpu: name=0 → (unknown) even with a size");
    n = iam_render_gpu(&rb, 256, "GPU", 0, gmem, 0);
    assert_buf_eq(&rb, n, "GPU:    (unknown)\n",
      "gpu: name=0 + mlen=0 → (unknown)");
    # Overflow signaling matches the other renderers.
    n = iam_render_gpu(&sb, 10, "GPU", "TooLongForThisBuffer", gmem, 5);
    assert_eq(n, 0 - 1, "gpu: cap=10 overflow returns -1");
    # F-001 sanitizer holds on the composed line — the device name is
    # mihi-sourced, so it routes through iam_copy_value like every
    # other value-column byte.
    n = iam_render_gpu(&rb, 256, "GPU", &ev, gmem, 5);
    assert_buf_eq(&rb, n, "GPU:    ?[31mRed [3 GiB]\n",
      "gpu: ESC in device name sanitized to '?'");

    # ----- Full ADR-contract output (ADR 0002 §2) -------------------
    # Six-line canonical shape — every required label in order, no
    # GPU line. Mirrors what `./build/iam` emits on a GPU-less box.
    # Order: identity (Distro / Host) → runtime (Kernel / Uptime) →
    # hardware (CPU / Memory) per ADR 0002.
    test_group("display.cyr — ADR-contract assembled output (six lines)");
    var out[1024];
    var pos = 0;
    var r6 = iam_render(&out + pos, 1024 - pos, "Distro", "Test OS");
    pos = pos + r6;
    r6 = iam_render(&out + pos, 1024 - pos, "Host", "testbox");
    pos = pos + r6;
    r6 = iam_render_kernel(&out + pos, 1024 - pos, "Kernel", "Linux", "1.0.0");
    pos = pos + r6;
    r6 = iam_render_buf(&out + pos, 1024 - pos, "Uptime", "1d 2h 3m", 8);
    pos = pos + r6;
    r6 = iam_render(&out + pos, 1024 - pos, "CPU", "Test CPU");
    pos = pos + r6;
    r6 = iam_render_buf(&out + pos, 1024 - pos, "Memory", "16 GiB", 6);
    pos = pos + r6;
    var six_line = "Distro: Test OS\nHost:   testbox\nKernel: Linux 1.0.0\nUptime: 1d 2h 3m\nCPU:    Test CPU\nMemory: 16 GiB\n";
    assert_buf_eq(&out, pos, six_line, "six-line ADR-contract assembly");

    # Seven-line variant — GPU line slots between CPU and Memory
    # (ADR 0002 §3) so the hardware block stays contiguous. We build
    # a fresh buffer here rather than appending to the six-line `out`
    # because GPU goes mid-output, not at the tail.
    test_group("display.cyr — ADR-contract assembled output (seven lines)");
    var out7[1024];
    var pos7 = 0;
    var r7 = iam_render(&out7 + pos7, 1024 - pos7, "Distro", "Test OS");
    pos7 = pos7 + r7;
    r7 = iam_render(&out7 + pos7, 1024 - pos7, "Host", "testbox");
    pos7 = pos7 + r7;
    r7 = iam_render_kernel(&out7 + pos7, 1024 - pos7, "Kernel", "Linux", "1.0.0");
    pos7 = pos7 + r7;
    r7 = iam_render_buf(&out7 + pos7, 1024 - pos7, "Uptime", "1d 2h 3m", 8);
    pos7 = pos7 + r7;
    r7 = iam_render(&out7 + pos7, 1024 - pos7, "CPU", "Test CPU");
    pos7 = pos7 + r7;
    r7 = iam_render_gpu(&out7 + pos7, 1024 - pos7, "GPU", "Test GPU", "8 GiB", 5);
    pos7 = pos7 + r7;
    r7 = iam_render_buf(&out7 + pos7, 1024 - pos7, "Memory", "16 GiB", 6);
    pos7 = pos7 + r7;
    var seven_line = "Distro: Test OS\nHost:   testbox\nKernel: Linux 1.0.0\nUptime: 1d 2h 3m\nCPU:    Test CPU\nGPU:    Test GPU [8 GiB]\nMemory: 16 GiB\n";
    assert_buf_eq(&out7, pos7, seven_line, "seven-line ADR-contract assembly");

    # Same seven lines with the accelerator's size unavailable —
    # locks the ADR 0003 degrade path at the assembled level, i.e.
    # proves a size-less probe reproduces the pre-0003 output bytes
    # exactly rather than leaking a placeholder into the line.
    var out7b[1024];
    var pos7b = 0;
    var r7b = iam_render(&out7b + pos7b, 1024 - pos7b, "Distro", "Test OS");
    pos7b = pos7b + r7b;
    r7b = iam_render(&out7b + pos7b, 1024 - pos7b, "Host", "testbox");
    pos7b = pos7b + r7b;
    r7b = iam_render_kernel(&out7b + pos7b, 1024 - pos7b, "Kernel", "Linux", "1.0.0");
    pos7b = pos7b + r7b;
    r7b = iam_render_buf(&out7b + pos7b, 1024 - pos7b, "Uptime", "1d 2h 3m", 8);
    pos7b = pos7b + r7b;
    r7b = iam_render(&out7b + pos7b, 1024 - pos7b, "CPU", "Test CPU");
    pos7b = pos7b + r7b;
    r7b = iam_render_gpu(&out7b + pos7b, 1024 - pos7b, "GPU", "Test GPU", "8 GiB", 0);
    pos7b = pos7b + r7b;
    r7b = iam_render_buf(&out7b + pos7b, 1024 - pos7b, "Memory", "16 GiB", 6);
    pos7b = pos7b + r7b;
    var seven_line_nomem = "Distro: Test OS\nHost:   testbox\nKernel: Linux 1.0.0\nUptime: 1d 2h 3m\nCPU:    Test CPU\nGPU:    Test GPU\nMemory: 16 GiB\n";
    assert_buf_eq(&out7b, pos7b, seven_line_nomem,
      "seven-line assembly, GPU size unavailable");

    # ----- Degraded-probe assembled output --------------------------
    # All-probe-failure scenario: every required line renders as
    # `(unknown)`, GPU line is suppressed (ngpu==0). Locks the
    # "never a blank line, never a stderr error" guarantee.
    test_group("display.cyr — degraded-probe output");
    var dout[1024];
    var dpos = 0;
    var dr = iam_render(&dout + dpos, 1024 - dpos, "Distro", 0);
    dpos = dpos + dr;
    dr = iam_render(&dout + dpos, 1024 - dpos, "Host", 0);
    dpos = dpos + dr;
    dr = iam_render(&dout + dpos, 1024 - dpos, "Kernel", 0);
    dpos = dpos + dr;
    dr = iam_render_buf(&dout + dpos, 1024 - dpos, "Uptime", dout, 0);
    dpos = dpos + dr;
    dr = iam_render(&dout + dpos, 1024 - dpos, "CPU", 0);
    dpos = dpos + dr;
    dr = iam_render_buf(&dout + dpos, 1024 - dpos, "Memory", dout, 0);
    dpos = dpos + dr;
    var degraded = "Distro: (unknown)\nHost:   (unknown)\nKernel: (unknown)\nUptime: (unknown)\nCPU:    (unknown)\nMemory: (unknown)\n";
    assert_buf_eq(&dout, dpos, degraded, "all-probe-failure six-line shape");

    # ----- v1.1.7 hardening: F-003 value-column bound ---------------
    # The audit finding this suite exists to prevent recurring: an
    # over-long value used to overflow the output buffer, and because
    # the driver only advances `pos` on a positive return, the whole
    # *required* line vanished. Six-required-lines (ADR 0002) is a
    # contract, so the value truncates and the line always renders.
    test_group("display.cyr — F-003 value-column bound");
    var bigv = alloc(8192);
    var bi = 0;
    while (bi < 5000) { store8(bigv + bi, 65); bi = bi + 1; }
    store8(bigv + 5000, 0);

    var fbuf[1024];
    var fr = iam_render(&fbuf, 1024, "CPU", bigv);
    assert_eq(fr, 8 + IAM_VALUE_MAX + 1,
      "over-long value truncates to IAM_VALUE_MAX, line still renders");
    assert_eq(load8(&fbuf + 8 + IAM_VALUE_MAX), 10,
      "truncated line still ends in a newline");
    assert_eq(load8(&fbuf), 67, "truncated line still starts with its label");

    # The exact defect: six required lines must survive a pathological
    # value in a 4 KiB buffer. Before the fix this assembled to 5.
    var abuf[4096];
    var apos = 0;
    var ar = iam_render(&abuf + apos, 4096 - apos, "Distro", "Arch Linux");
    if (ar > 0) { apos = apos + ar; }
    ar = iam_render(&abuf + apos, 4096 - apos, "Host", "archaemenid");
    if (ar > 0) { apos = apos + ar; }
    ar = iam_render_kernel(&abuf + apos, 4096 - apos, "Kernel", "Linux", "7.1.8");
    if (ar > 0) { apos = apos + ar; }
    ar = iam_render_buf(&abuf + apos, 4096 - apos, "Uptime", "1d 1h", 5);
    if (ar > 0) { apos = apos + ar; }
    ar = iam_render(&abuf + apos, 4096 - apos, "CPU", bigv);
    if (ar > 0) { apos = apos + ar; }
    ar = iam_render_buf(&abuf + apos, 4096 - apos, "Memory", "59 GiB", 6);
    if (ar > 0) { apos = apos + ar; }
    var alines = 0;
    bi = 0;
    while (bi < apos) {
        if (load8(&abuf + bi) == 10) { alines = alines + 1; }
        bi = bi + 1;
    }
    assert_eq(alines, 6, "pathological value keeps the six-line contract");

    # Every renderer routes its value column through the same choke
    # point, so the bound has to hold for all four.
    var kr = iam_render_kernel(&fbuf, 1024, "Kernel", bigv, "1.0");
    assert_eq(kr, 8 + IAM_VALUE_MAX + 1 + 3 + 1, "kernel name is bounded too");
    var gr = iam_render_gpu(&fbuf, 1024, "GPU", bigv, "3 GiB", 5);
    assert_eq(gr, 8 + IAM_VALUE_MAX + 1 + 1 + 5 + 1 + 1, "gpu name is bounded too");
    var br = iam_render_buf(&fbuf, 1024, "Memory", bigv, 5000);
    assert_eq(br, 8 + IAM_VALUE_MAX + 1, "buf-variant value is bounded too");

    # A value exactly at the cap is not truncated (off-by-one guard).
    var exactv = alloc(512);
    bi = 0;
    while (bi < IAM_VALUE_MAX) { store8(exactv + bi, 66); bi = bi + 1; }
    store8(exactv + IAM_VALUE_MAX, 0);
    var er = iam_render(&fbuf, 1024, "CPU", exactv);
    assert_eq(er, 8 + IAM_VALUE_MAX + 1, "value exactly at the cap is untouched");

    # ----- v1.1.7 hardening: UTF-8 boundary on truncation -----------
    # Cutting at a fixed byte offset can land mid-sequence. A 3-byte
    # sequence starting at 254 would be sliced after its first byte,
    # emitting an invalid fragment; the cut backs off to 254 instead.
    test_group("display.cyr — F-003 truncation lands on a UTF-8 boundary");
    var uv = alloc(1024);
    bi = 0;
    while (bi < 254) { store8(uv + bi, 67); bi = bi + 1; }   # 254x 'C'
    store8(uv + 254, 226);   # 0xE2  lead byte of a 3-byte sequence
    store8(uv + 255, 128);   # 0x80  continuation
    store8(uv + 256, 153);   # 0x99  continuation
    bi = 257;
    while (bi < 600) { store8(uv + bi, 67); bi = bi + 1; }
    store8(uv + 600, 0);
    var ur = iam_render(&fbuf, 1024, "CPU", uv);
    assert_eq(ur, 8 + 254 + 1, "truncation backs off to the character boundary");
    assert_eq(load8(&fbuf + 8 + 253), 67, "last kept byte is the complete char before the cut");
    assert_eq(load8(&fbuf + 8 + 254), 10, "no partial sequence is emitted");

    # ----- v1.1.7 hardening: F-005 DEL (0x7F) sanitization ----------
    # C0 is 0x00-0x1F *plus* DEL by ECMA-48; the original F-001 filter
    # covered only the low run. C1 (0x80-0x9F) stays unfiltered on
    # purpose — those are UTF-8 continuation bytes on a UTF-8 terminal.
    test_group("display.cyr — F-005 DEL sanitization");
    var dv = alloc(64);
    store8(dv, 65); store8(dv + 1, 127); store8(dv + 2, 66); store8(dv + 3, 0);
    var dr7 = iam_render(&fbuf, 1024, "CPU", dv);
    assert_buf_eq(&fbuf, dr7, "CPU:    A?B
", "DEL (0x7F) is replaced with '?'");

    var utf8v = alloc(64);
    store8(utf8v, 195); store8(utf8v + 1, 169); store8(utf8v + 2, 0);   # "é" in UTF-8
    var cr = iam_render(&fbuf, 1024, "CPU", utf8v);
    assert_eq(load8(&fbuf + 8), 195, "UTF-8 lead byte survives sanitization");
    assert_eq(load8(&fbuf + 9), 169, "UTF-8 continuation byte survives sanitization");

    # ----- v1.1.7 hardening: F-007 primitive bounds -----------------
    # The copy primitives are the last line of defence; a negative
    # length must be refused rather than silently rewinding `pos`.
    test_group("display.cyr — F-007 copy-primitive bounds");
    # Non-zero `pos` is load-bearing in these two: at pos==0 the old
    # additive check returned `0 + (-1)` == -1 and looked correct by
    # accident. The actual defect only shows with the cursor advanced —
    # the primitive returned `pos + len`, silently REWINDING the write
    # cursor (10 -> 9) instead of refusing the copy.
    assert_eq(iam_copy(&fbuf, 1024, 10, "abc", 0 - 1), 0 - 1,
      "iam_copy refuses a negative length instead of rewinding pos");
    assert_eq(iam_copy_value(&fbuf, 1024, 10, "abc", 0 - 1), 0 - 1,
      "iam_copy_value refuses a negative length instead of rewinding pos");
    assert_eq(iam_copy(&fbuf, 8, 0, "abcdefghij", 10), 0 - 1,
      "iam_copy refuses a copy past cap");
    assert_eq(iam_copy(&fbuf, 8, 0, "abcdefgh", 8), 8,
      "iam_copy accepts a copy that exactly fills cap");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
