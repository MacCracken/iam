# iam — main entry point.
#
# Six required labeled lines plus an optional GPU line, accumulated
# into one output buffer and flushed with a single write syscall.
# Line order, label format, and the `(unknown)` fallback policy are
# locked at docs/adr/0002-output-shape-reorder.md (which supersedes
# ADR 0001 §2-§3; ADR 0001 §1, §4, §5, §6 carry over unchanged).
#
# Design principle: NO theming engine, NO plugin system, NO
# configurable output. `whoami` prints the user; `iam` prints the
# system — same minimalism.
#
# Stdlib auto-included via cyrius.cyml [deps].stdlib. mihi and
# ai-hwaccel bundles arrive in lib/ via `cyrius deps`.

include "src/display.cyr"
include "src/uptime.cyr"

# Output buffer cap. Real-world worst case: ~50-byte /proc/cpuinfo
# model name + 8-byte label + newline ≈ 60 bytes per line; 7 lines
# ≈ 420 bytes. 4 KiB leaves ~10× headroom for pathological
# distro PRETTY_NAMEs / CPU model strings without risking overflow.
enum IamMain {
    IAM_OUT_CAP = 4096;

    # Retry sentinel for the stdout flush. Defined here rather than
    # taken from the stdlib: `EINTR` is declared in the Linux and macOS
    # syscall modules but *not* in `syscalls_x86_64_agnos.cyr`, so
    # referencing the stdlib name compiles on host and aarch64 and
    # fails the `--agnos` build. iam is an agnos build target, so the
    # constant lives locally. Value is the POSIX errno, returned by a
    # raw `syscall(SYS_WRITE, ...)` as its negation.
    IAM_EINTR = 4;
}

# Flush `len` bytes of `buf` to stdout, looping until the kernel has
# taken all of them.
#
# `print()` is a bare `sys_write` whose return value it discards, so a
# short write silently truncates the report and an `-EINTR` loses it
# outright. write(2) is under no obligation to consume the whole
# buffer in one call — this is the exact symmetric counterpart of the
# short-read defect mihi's own 1.2.3 audit fixed (A-1), and it lands
# on the login path where a half-printed MOTD is a visible failure.
#
# `sys_write` is a bare `syscall(SYS_WRITE, ...)` returning the raw
# kernel value, so an error arrives as `-errno`. `-IAM_EINTR` is retried
# rather than treated as fatal: it means no bytes moved and the call
# should simply be reissued. Any other negative return is a real error
# (EPIPE, EIO) and stops the loop — there is nowhere useful to report
# it to, and ADR 0001 §6 says the exit code stays 0 regardless.
#
# Returns bytes actually written.
fn iam_flush(buf, len): i64 {
    var off = 0;
    var go = 1;
    var n = 0;
    while (go == 1) {
        if (off >= len) {
            go = 0;
        } else {
            n = file_write(STDOUT, buf + off, len - off);
            if (n > 0) {
                off = off + n;
            } else {
                # n == 0 would spin forever; treat it as end-of-progress.
                if (n != 0 - IAM_EINTR) { go = 0; }
            }
        }
    }
    return off;
}

fn main() {
    alloc_init();

    # One uname(2) syscall feeds three probes: kernel_name,
    # kernel_version, hostname. See mihi docs/adr/0001-shared-uts-buffer.md.
    var uts[390];
    var ures = mihi_uname(&uts);
    var uok = 1;
    if (is_err_result(ures) == 1) { uok = 0; }

    # CPU model — 8 KiB scratch. HEAP, not stack: agnos gives a program only ~12 KB
    # of usable user stack (elf.cyr exec layout), so an 8 KiB stack buffer here + the
    # other locals overflowed it → #PF (user write to the unmapped page below rsp).
    # /proc/cpuinfo first-block (Linux) fits; agnos fills it from CPUID (mihi 1.2.0).
    var cpubuf = alloc(8192);
    var cpu = mihi_cpu_model(cpubuf, 8192);

    # Memory total. /proc/meminfo is ~1.5 KB; 4 KiB scratch is the
    # mihi-recommended cap. Bytes → "31 GiB" via iam_format_bytes.
    var membuf = alloc(4096);   # heap, not stack (see cpubuf — the ~12 KB user-stack cap)
    var mbytes = mihi_mem_total(membuf, 4096);
    var memout[24];
    var mlen = 0;
    if (mbytes > 0) { mlen = iam_format_bytes(mbytes, &memout, 24); }

    # Distro PRETTY_NAME (or ID fallback). 1 KiB scratch.
    var distbuf[1024];
    var distro = mihi_distro(&distbuf, 1024);

    # Uptime seconds → "1d 2h 3m". /proc/uptime is ~32 B; 64 B scratch.
    var upbuf[64];
    var usecs = mihi_uptime_secs(&upbuf, 64);
    var upout[24];
    var ulen = 0;
    if (usecs >= 0) { ulen = iam_format_uptime(usecs, &upout, 24); }

    # Accelerator count gates the optional GPU line; the first
    # device's on-device memory becomes its "[3 GiB]" suffix (ADR
    # 0003). Mirrors the Memory block above — probe bytes, format
    # into scratch, hand the driver a buf+len.
    #
    # mihi_gpu_memory_bytes returns 0 - 1 for an out-of-range index
    # and 0 where the backend carries no size figure; both fall
    # below the `> 0` gate, so glen stays 0 and the line degrades to
    # the bare device name. No probe is issued at all when the box
    # has no accelerator.
    var ngpu = mihi_gpu_count();
    var gbytes = 0 - 1;
    if (ngpu > 0) { gbytes = mihi_gpu_memory_bytes(0); }
    var gmemout[24];
    var glen = 0;
    if (gbytes > 0) { glen = iam_format_bytes(gbytes, &gmemout, 24); }

    # Accumulate the seven possible lines into one output buffer,
    # then flush with a single write syscall. Order matches the
    # ADR 0002 contract — identity → runtime → hardware spine:
    # Distro / Host / Kernel / Uptime / CPU / GPU? / Memory. The
    # optional GPU line slots between CPU and Memory so the
    # hardware block stays contiguous.
    var out[4096];
    var pos = 0;
    var n = 0;

    n = iam_render(&out + pos, IAM_OUT_CAP - pos, "Distro", distro);
    if (n > 0) { pos = pos + n; }

    if (uok == 1) {
        n = iam_render(&out + pos, IAM_OUT_CAP - pos, "Host", mihi_hostname(&uts));
        if (n > 0) { pos = pos + n; }
        n = iam_render_kernel(&out + pos, IAM_OUT_CAP - pos,
          "Kernel", mihi_kernel_name(&uts),
          mihi_kernel_version(&uts));
        if (n > 0) { pos = pos + n; }
    } else {
        n = iam_render(&out + pos, IAM_OUT_CAP - pos, "Host", 0);
        if (n > 0) { pos = pos + n; }
        n = iam_render(&out + pos, IAM_OUT_CAP - pos, "Kernel", 0);
        if (n > 0) { pos = pos + n; }
    }

    n = iam_render_buf(&out + pos, IAM_OUT_CAP - pos, "Uptime", &upout, ulen);
    if (n > 0) { pos = pos + n; }

    n = iam_render(&out + pos, IAM_OUT_CAP - pos, "CPU", cpu);
    if (n > 0) { pos = pos + n; }

    # Optional GPU line — slotted between CPU and Memory to keep the
    # hardware block contiguous. Suppressed entirely when
    # mihi_gpu_count is 0 (not an error: most servers and CI runners
    # have no accelerator, and neither does a headless agnos box).
    # On count >= 1 we emit the first device; multi-GPU boxes are
    # rare enough that iam stays whoami-simple here (ADR 0002
    # alternatives-considered). Name plus optional size suffix per
    # ADR 0003; `glen == 0` renders the bare name.
    if (ngpu > 0) {
        n = iam_render_gpu(&out + pos, IAM_OUT_CAP - pos, "GPU",
          mihi_gpu_name(0), &gmemout, glen);
        if (n > 0) { pos = pos + n; }
    }

    n = iam_render_buf(&out + pos, IAM_OUT_CAP - pos, "Memory", &memout, mlen);
    if (n > 0) { pos = pos + n; }

    # Single flush — normally one write syscall for the whole report.
    # The ADR's "TTY == pipe" guarantee is automatic: no per-stream
    # mode-switching, no flush boundaries that could differ. The loop
    # inside iam_flush only ever iterates if the kernel takes a partial
    # buffer or interrupts the call; the common path is still one write.
    iam_flush(&out, pos);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
