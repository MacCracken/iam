[package]
name = "iam"
version = "${file:VERSION}"
description = "iam — fastfetch-equivalent system info display. Pure inverse of whoami: whoami says who the user is, iam says what the system is. Thin presentation over the mihi probe library."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "iam"

[deps]
stdlib = [
    "string", "fmt", "alloc", "io", "vec", "str", "slice",
    "syscalls", "sys", "assert", "fs", "tagged", "process",
    "fnptr", "thread", "freelist", "hashmap", "sakshi", "ct",
    "bayan", "bench",
]

# The system-info probe library. Every displayed line is a mihi_* probe.
[deps.mihi]
git = "https://github.com/MacCracken/mihi.git"
tag = "1.3.2"
modules = ["dist/mihi.cyr"]

# Accelerator detection, referenced by mihi's GPU probes.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.5.5"
modules = ["dist/ai-hwaccel.cyr"]

# bayan's JSON sublib, declared as mihi declares it.
[deps.bayan]
optional = true
git = "https://github.com/MacCracken/bayan.git"
tag = "1.11.1"
modules = ["dist/bayan-json.cyr"]

[features]
default = ["bayan"]
